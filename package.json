{
  "name": "koishi-plugin-qzone",
  "version": "0.2.0",
  "description": "QQ Space integration for Koishi with OneBot, QR login, and cookie adapters",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node tests/integration.cjs",
    "test:watch": "vitest"
  },
  "keywords": [
    "koishi",
    "qq",
    "qzone",
    "onebot"
  ],
  "license": "GPL-3.0-only",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "koishi": {
    "description": {
      "zh": "QQ 空间查看、发布、点赞、评论与定时任务",
      "en": "QQ Space feeds, publishing, likes, comments, and scheduled tasks"
    },
    "service": {
      "optional": [
        "database"
      ]
    }
  },
  "peerDependencies": {
    "koishi": "^4.18.0"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "cron-parser": "^5.4.0",
    "json5": "^2.2.3",
    "tough-cookie": "^6.0.2",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@types/node": "^24.0.0",
    "koishi": "^4.18.11",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
