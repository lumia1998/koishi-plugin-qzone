{
  "name": "koishi-plugin-qzone",
  "version": "0.0.5",
  "description": "测试中，不推荐下载。支持 OneBot 自动刷新与二维码登录的 ChatLuna QQ 空间工具",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node tests/integration.cjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm test && npm run test:integration"
  },
  "keywords": [
    "koishi",
    "qq",
    "qzone",
    "onebot",
    "chatluna"
  ],
  "license": "GPL-3.0-only",
  "author": "lumia1998",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumia1998/koishi-plugin-qzone.git"
  },
  "homepage": "https://github.com/lumia1998/koishi-plugin-qzone#readme",
  "bugs": {
    "url": "https://github.com/lumia1998/koishi-plugin-qzone/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "koishi": {
    "description": {
      "zh": "测试中，不推荐下载。为 ChatLuna 提供 QQ 空间查询、发布、点赞与评论",
      "en": "Experimental and not recommended for installation. QQ Space tools for ChatLuna"
    },
    "service": {
      "required": [
        "chatluna"
      ],
      "optional": [
        "database"
      ]
    }
  },
  "peerDependencies": {
    "koishi": "^4.18.0",
    "koishi-plugin-chatluna": "^1.3.36 || ^1.4.0-alpha.0"
  },
  "dependencies": {
    "@langchain/core": "https://codeload.github.com/lumia1998/langchain-core-legacy-safe/tar.gz/894de847dd2b00c858f037dd540089d90828f017",
    "cheerio": "1.0.0",
    "json5": "^2.2.3",
    "tough-cookie": "^6.0.2",
    "undici": "^6.28.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@types/node": "^24.0.0",
    "koishi": "^4.18.11",
    "koishi-plugin-chatluna": "^1.3.36",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
